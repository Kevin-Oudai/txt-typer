<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>txt-typer</AssemblyName>
    <RootNamespace>TxtTyper</RootNamespace>
    <ApplicationIcon>Assets\txt-typer.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\txt-typer.ico" />
    <Resource Include="Assets\txt-typer.ico" />
  </ItemGroup>
</Project>
