<Window x:Class="TxtTyper.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="txt-typer"
        Icon="/Assets/txt-typer.ico"
        Width="1460"
        Height="860"
        MinWidth="1280"
        MinHeight="760"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Border Margin="18"
                Background="{StaticResource ShellGradientBrush}"
                CornerRadius="28">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.ColumnSpan="5" Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}"
                                   FontSize="28"
                                   Text="txt-typer" />
                        <TextBlock Margin="0,6,0,0"
                                   Style="{StaticResource SectionHintStyle}"
                                   FontSize="13"
                                   Text="Write or load a script, start the countdown, switch to another window, and txt-typer will simulate real keystrokes line by line." />
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                            <Button Margin="0,0,12,0"
                                    Style="{StaticResource QuickStartButtonStyle}"
                                    Command="{Binding StartTypingCommand}">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="26"
                                               FontWeight="Black"
                                               Foreground="White"
                                               Text="START" />
                                    <TextBlock Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="#FFF0FFF3"
                                               Text="Start Typing" />
                                </StackPanel>
                            </Button>
                            <Button Margin="0,0,12,0"
                                    Style="{StaticResource EmergencyButtonStyle}"
                                    Command="{Binding StopCommand}">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="28"
                                               FontWeight="Black"
                                               Foreground="White"
                                               Text="STOP" />
                                    <TextBlock Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#FFFDE7E7"
                                               Text="Ctrl+Alt+F12" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource QuickClearButtonStyle}"
                                    Command="{Binding ClearEditorCommand}">
                                <StackPanel>
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="24"
                                               FontWeight="Black"
                                               Text="CLEAR" />
                                    <TextBlock Margin="0,6,0,0"
                                               HorizontalAlignment="Center"
                                               Style="{StaticResource SectionHintStyle}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Text="Clear Editor" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock Margin="0,8,4,0"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource SectionHintStyle}"
                                   Text="Primary actions stay in the header. Ctrl+Alt+F12 still triggers emergency stop globally." />
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Saved Snippets" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource SectionHintStyle}"
                                       Text="Snippets are stored locally as JSON and loaded into the editor before they can be run." />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,18,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Snippet Name" />
                            <TextBox Text="{Binding SnippetName, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <TextBlock Grid.Row="2"
                                   Margin="0,18,0,6"
                                   Style="{StaticResource LabeledValueTextStyle}"
                                   Text="Available Snippets" />

                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding Snippets}"
                                 SelectedItem="{Binding SelectedSnippet}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Name}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="{Binding Content}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Grid.Row="4" Margin="0,18,0,0">
                            <Button Style="{StaticResource NeutralButtonStyle}"
                                    Command="{Binding NewSnippetCommand}"
                                    Content="New Snippet" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Command="{Binding SaveSnippetCommand}"
                                    Content="Save Snippet" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource NeutralButtonStyle}"
                                    Command="{Binding DeleteSnippetCommand}"
                                    Content="Delete Snippet" />
                            <Button Margin="0,10,0,0"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding LoadSnippetCommand}"
                                    Content="Load Into Editor" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Script Editor" />
                            <TextBlock Margin="0,4,0,0"
                                       Style="{StaticResource SectionHintStyle}"
                                       Text="Indentation, spaces, tabs, and punctuation are preserved exactly. Tokens are only interpreted when the control-token option is enabled." />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,18,0,0"
                                Background="{StaticResource PanelAltBackgroundBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="LineNumbersTextBox"
                                         Grid.Column="0"
                                         Padding="0,12,10,12"
                                         Background="#FFF1F5F8"
                                         BorderThickness="0"
                                         Focusable="False"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13.5"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         HorizontalContentAlignment="Right"
                                         IsHitTestVisible="False"
                                         IsReadOnly="True"
                                         HorizontalScrollBarVisibility="Hidden"
                                         Text="{Binding LineNumbersText, Mode=OneWay}"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Hidden" />

                                <TextBox x:Name="EditorTextBox"
                                         Grid.Column="1"
                                         Padding="12"
                                         AcceptsReturn="True"
                                         AcceptsTab="True"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         FontFamily="Cascadia Mono, Consolas"
                                         FontSize="13.5"
                                         HorizontalScrollBarVisibility="Auto"
                                         SpellCheck.IsEnabled="False"
                                         Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="NoWrap"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="X" Modifiers="Control" Command="ApplicationCommands.Cut" />
                                        <KeyBinding Key="C" Modifiers="Control" Command="ApplicationCommands.Copy" />
                                        <KeyBinding Key="V" Modifiers="Control" Command="ApplicationCommands.Paste" />
                                        <KeyBinding Key="Delete" Modifiers="Shift" Command="ApplicationCommands.Cut" />
                                        <KeyBinding Key="Insert" Modifiers="Control" Command="ApplicationCommands.Copy" />
                                        <KeyBinding Key="Insert" Modifiers="Shift" Command="ApplicationCommands.Paste" />
                                    </TextBox.InputBindings>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Border Grid.Row="2"
                                Margin="0,18,0,0"
                                Padding="12"
                                Background="#FFF8FBFD"
                                BorderBrush="{StaticResource PanelBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14">
                            <TextBlock Style="{StaticResource SectionHintStyle}"
                                       Text="Normal lines are typed and finished with Enter. A line containing only {WAIT:milliseconds} pauses without adding Enter." />
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="4"
                        Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  CanContentScroll="False"
                                  Padding="0,0,4,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitleStyle}"
                                       Text="Settings" />

                            <TextBlock Margin="0,18,0,6"
                                       Style="{StaticResource LabeledValueTextStyle}"
                                       Text="Countdown Before Start (seconds)" />
                            <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                     Text="{Binding CountdownSeconds, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,16,0,6"
                                       Style="{StaticResource LabeledValueTextStyle}"
                                       Text="Character Delay (ms)" />
                            <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                     Text="{Binding CharacterDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,16,0,6"
                                       Style="{StaticResource LabeledValueTextStyle}"
                                       Text="Line Delay After Enter (ms)" />
                            <TextBox Style="{StaticResource NumericTextBoxStyle}"
                                     Text="{Binding LineDelayMilliseconds, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel Margin="0,14,0,0">
                                <CheckBox Content="Preserve blank lines"
                                          IsChecked="{Binding PreserveBlankLines}" />
                                <CheckBox Content="Enable control tokens"
                                          IsChecked="{Binding EnableControlTokens}" />
                                <CheckBox Content="Require confirmation before start"
                                          IsChecked="{Binding RequireConfirmationBeforeStart}" />
                            </StackPanel>

                            <TextBlock Margin="0,18,0,0"
                                       Style="{StaticResource SectionHintStyle}"
                                       Text="Default values: countdown 5s, character delay 35ms, line delay 250ms, preserve blank lines on, control tokens on." />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Border Grid.Row="2"
                        Grid.ColumnSpan="5"
                        Margin="0,18,0,0"
                        Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.3*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Current Status" />
                            <TextBlock FontSize="16"
                                       FontWeight="SemiBold"
                                       Text="{Binding StatusMessage}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Countdown" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Text="{Binding CountdownDisplay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Current Line" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Text="{Binding CurrentLineDisplay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Estimated Time" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Text="{Binding EstimatedTimeDisplay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Indicator" />
                            <StackPanel Orientation="Horizontal">
                                <Border Width="14"
                                        Height="14"
                                        Margin="0,6,10,0"
                                        CornerRadius="7">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource InactiveBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTypingActive}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource ActiveBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock FontSize="16"
                                           FontWeight="SemiBold"
                                           Text="{Binding ActivityState}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Margin="28,0,0,0">
                            <TextBlock Style="{StaticResource LabeledValueTextStyle}" Text="Stop Shortcut" />
                            <TextBlock FontFamily="Cascadia Mono, Consolas"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="Ctrl+Alt+F12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
